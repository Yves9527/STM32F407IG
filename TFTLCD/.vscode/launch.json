{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex-Debug (OpenOCD CMSIS-DAP)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "executable": "${command:cmake.launchTargetPath}",
            "cwd": "${workspaceFolder}",
            "device": "STM32F407IG",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/stm32f4x.cfg"
            ],
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            "openOCDLaunchCommands": [
                "stm32f4x.cpu configure -event gdb-detach { resume }"
            ]
        }
    ]
}